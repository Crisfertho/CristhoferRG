---
import ExpComponent from "./ExpComponent.astro"

const EXPERIENCE = [
    
    {
        date: 'Octubre 2025',
        title: 'Freelance',
        description: 'Desarrollo de una tienda online utilizando Vue, Laravel y MySQL, con funcionalidades de carrito de compras y panel de administración.'
    },
    {
        date: 'Diciembre 2022',
        title: 'Pasantía en Listica SRL',
        description: 'Pasantía unversitaria en Listica como desarrollador Frontend, utilizando tecnologías como React, Boostratp, HTML, CSS...',
    },
]
---
<ol class="relative border-s border-gray-20">  
    {
        EXPERIENCE.map(experience => (
        <li class="mb-10 ms-5">   
            <ExpComponent {...experience} />         
        </li>
        ))
    }                
</ol>